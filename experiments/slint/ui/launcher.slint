// SPDX-License-Identifier: MPL-2.0
import { TextEdit as NativeTextEdit, ListView, ScrollView, CheckBox, AboutSlint, Palette } from "std-widgets.slint";


export struct GameRow { id: string, title: string, subtitle: string, icon: string }
export struct VersionRow { id: string, kind: string }
export struct ContentRow { title: string, description: string, meta: string, initial: string, icon: image, has-icon: bool, downloaded: bool, index: int }
export struct OptionalRow { title: string, selected: bool, downloaded: bool, icon: image, has-icon: bool }
export struct ContentVersionRow { index: int, title: string, details: string, game: string, recommended: bool, compatible: bool, downloaded: bool }
export struct ContentVersionGroup { title: string, rows: [ContentVersionRow] }
export struct PlanRow { title: string, path: string, downloaded: bool }
export global Locale {
    in-out property <bool> english: false;
}
export global Theme {
    in-out property <bool> light: false;
    in-out property <bool> motion: true;
    in-out property <bool> keyboard-focus: false;
    in-out property <color> brand: #62d6b4;
    in-out property <color> primary-ink: #102d27;
    out property <length> radius: 8px;
    out property <color> text: light ? #183d35 : #f2f6f3;
    out property <color> secondary: light ? #3d5d56 : #becacb;
    out property <color> accent: light ? brand.darker(0.45) : brand.brighter(0.28);
    out property <color> glass: light ? #eff9f3dc : #11232fc2;
    out property <color> dialog: light ? #f2faf5f2 : #10232dde;
    out property <color> border: light ? #244e3e30 : #ffffff14;
    out property <color> focus: accent;
    out property <color> selection: brand.with-alpha(light ? 0.16 : 0.2);
    out property <color> control: light ? #ffffff70 : #ffffff0c;
    out property <color> hover: light ? #14725b20 : #ffffff20;
    out property <color> disabled: light ? #687d77 : #b4c3c2;
    out property <color> inset: light ? #ffffff60 : #06182148;
}
export global GlassAssets {
    in-out property <bool> ready: false;
    in-out property <int> revision: 0;
    pure callback tile(float, float, float, float, float, float, int) -> image;
}
component Action inherits Rectangle {
    in property <string> label;
    in property <string> hint;
    in property <bool> primary: false;
    in property <bool> flat: false;
    in property <bool> leading: false;
    in property <bool> on-scene: false;
    in property <bool> selected: false;
    in property <bool> enabled: true;
    callback clicked();
    height: 44px; min-width: 64px; border-radius: Theme.radius;
    animate background { duration: Theme.motion ? 130ms : 0ms; easing: ease-out; }
    animate border-color { duration: Theme.motion ? 130ms : 0ms; easing: ease-out; }
    background: primary ? (!enabled ? Theme.brand.with-alpha(0.4) : touch.has-hover ? Theme.brand.brighter(0.12) : Theme.brand) : selected ? Theme.selection : touch.has-hover ? Theme.hover : flat ? transparent : Theme.control;
    border-width: focus.has-focus && Theme.keyboard-focus ? 2px : primary || flat ? 0px : 1px;
    border-color: focus.has-focus && Theme.keyboard-focus ? (on-scene ? #c1f5e8 : Theme.focus) : selected ? Theme.focus : Theme.border;
    accessible-role: button; accessible-label: hint + " " + label; accessible-enabled: enabled;
    accessible-action-default => { if enabled { root.clicked(); } }
    if hint != "": Text { vertical-stretch: 0; x: 16px; y: 8px; width: parent.width - 32px; height: 16px; text: root.hint; color: Theme.secondary; font-size: 12px; overflow: elide; }
    Text { vertical-stretch: 0; x: root.hint == "" ? 8px : 16px; y: root.hint == "" ? 0px : 26px; width: parent.width - (root.hint == "" ? 16px : 32px); height: root.hint == "" ? parent.height : 22px;
        text: root.label; color: !root.enabled ? Theme.disabled : root.primary ? Theme.primary-ink : root.on-scene ? #f2f6f3 : Theme.text; font-size: root.primary ? 20px : 14px;
        font-weight: root.primary || root.selected ? 600 : 400; horizontal-alignment: root.hint == "" && !root.leading ? center : left; vertical-alignment: center; overflow: elide;
    }
    focus := FocusScope { enabled: root.enabled;
        key-pressed(event) => { if !event.modifiers.alt && !event.modifiers.control && !event.modifiers.meta && (event.text == "\n" || event.text == " ") { root.clicked(); return accept; } return reject; }
    }
    touch := TouchArea { enabled: root.enabled; clicked => { Theme.keyboard-focus=false; focus.focus(); root.clicked(); } }
}
component Button inherits Action { in property <string> text; label: text; height: 40px; }
component LineEdit inherits Rectangle {
    in-out property <string> text <=> input.text;
    in property <string> placeholder-text;
    in property <bool> enabled: true;
    in property <bool> read-only: false;
    in property <InputType> input-type: InputType.text;
    callback edited(string); callback accepted(string); callback editing-finished();
    height: 40px; min-width: 60px; horizontal-stretch: 1; vertical-stretch: 0;
    border-radius: Theme.radius; background: Theme.control; border-width: 1px;
    border-color: input.has-focus ? Theme.accent : Theme.border;
    forward-focus: input;
    accessible-role: text-input; accessible-enabled: enabled; accessible-value: text;
    accessible-placeholder-text: placeholder-text; accessible-read-only: read-only;
    accessible-action-set-value(v) => { if enabled && !read-only { text=v; edited(v); } }
    Text { x: 12px; width: parent.width - 24px; height: parent.height; text: root.text == "" && input.preedit-text == "" ? root.placeholder-text : ""; color: Theme.secondary; vertical-alignment: center; overflow: elide; }
    input := TextInput { x: 12px; y: (parent.height - self.height)/2; width: parent.width - 24px; height: self.preferred-height;
        enabled: root.enabled; read-only: root.read-only; input-type: root.input-type; single-line: true;
        color: root.enabled ? Theme.text : Theme.disabled;
        selection-background-color: Theme.brand; selection-foreground-color: Theme.primary-ink;
        edited => { root.edited(self.text); } accepted => { root.accepted(self.text); }
        changed has-focus => { if !self.has-focus {root.editing-finished();} }
    }
    ContextMenuArea { Menu {
        MenuItem { title: @tr("撤销"); enabled: root.enabled && !root.read-only; activated => {input.undo();} }
        MenuItem { title: @tr("剪切"); enabled: root.enabled && !root.read-only; activated => {input.cut();} }
        MenuItem { title: @tr("复制"); activated => {input.copy();} }
        MenuItem { title: @tr("粘贴"); enabled: root.enabled && !root.read-only; activated => {input.paste();} }
        MenuItem { title: @tr("全选"); activated => {input.select-all();} }
    } }
}
component SpinBox inherits Rectangle {
    in-out property <int> value: 0;
    in property <int> minimum: 0; in property <int> maximum: 100;
    in property <bool> enabled: true;
    height: 40px; min-width: 110px; vertical-stretch: 0;
    function commit() { if editor.text.is-float() {value=round(editor.text.to-float()).clamp(minimum,maximum);} editor.text="" + value; }
    changed value => {editor.text="" + value;}
    HorizontalLayout { spacing: 6px;
        editor := LineEdit { text: "" + root.value; input-type: number; enabled: root.enabled; accepted => {root.commit();} editing-finished => {root.commit();} }
        Action { width: 32px; height: 40px; label: "-"; enabled: root.enabled && root.value > root.minimum; clicked => {root.value -= 1;} }
        Action { width: 32px; height: 40px; label: "+"; enabled: root.enabled && root.value < root.maximum; clicked => {root.value+=1;} }
    }
}
component TextEdit inherits Rectangle {
    in-out property <string> text;
    in property <bool> read-only: true;
    in property <length> font-size: 14px;
    accessible-role: text-input; accessible-value: text; accessible-read-only: read-only;
    border-radius: Theme.radius; background: Theme.control; border-width: 1px; border-color: Theme.border; clip: true;
    NativeTextEdit { x: 4px; y: 4px; width: parent.width - 8px; height: parent.height - 8px; text <=> root.text; read-only: root.read-only; font-size: root.font-size; }
}
component WindowControl inherits Rectangle {
    in property <string> kind; in property <string> label;
    callback clicked();
    width: 36px; height: 36px; border-radius: Theme.radius;
    background: mouse.has-hover ? (kind == "close" ? #c64249 : Theme.hover) : transparent;
    accessible-role: button; accessible-label: label;
    accessible-action-default => {root.clicked();}
    Image { x: 10px; y: 10px; width: 16px; height: 16px; colorize: Theme.text;
        source: root.kind == "minimize" ? @image-url("../../../assets/ui/minimize.svg") : root.kind == "close" ? @image-url("../../../assets/ui/close.svg") : root.kind == "restore" ? @image-url("../../../assets/ui/restore.svg") : @image-url("../../../assets/ui/maximize.svg");
    }
    FocusScope { key-pressed(e) => {if e.text == Key.Return || e.text == " " {root.clicked();return accept;}return reject;} }
    mouse := TouchArea {clicked => {root.clicked();}}
}
// Mouse focus is quiet; keyboard focus remains visible for navigation.
component ComboBox inherits Rectangle {
    in property <[string]> model;
    in property <bool> enabled: true;
    in-out property <int> current-index: 0;
    out property <string> current-value: current-index >= 0 && current-index < model.length ? model[current-index] : "";
    callback selected(string);
    property <int> pending: 0;
    property <bool> popup-open: false;
    height: 40px; min-width: 90px; horizontal-stretch: 1; vertical-stretch: 0;
    background: enabled ? mouse.has-hover ? Theme.hover : Theme.control : Theme.inset;
    border-radius: Theme.radius; border-width: 1px;
    border-color: field.has-focus && Theme.keyboard-focus ? Theme.focus : Theme.border;
    forward-focus: field;
    accessible-role: combobox; accessible-enabled: enabled; accessible-value: current-value;
    accessible-expandable: true; accessible-expanded: popup-open;
    accessible-action-expand => { if enabled { root.show(); } }
    function show() { pending = max(0,current-index); popup-open=true; options.show(); }
    function choose() { if pending >= 0 && pending < model.length { current-index=pending; selected(current-value); } popup-open=false; options.close(); field.focus(); }
    HorizontalLayout { padding-left: 12px; padding-right: 12px; spacing: 8px;
        Text { text: root.current-value; color: root.enabled ? Theme.text : Theme.disabled; overflow: elide; vertical-alignment: center; }
        Image { width: 16px; height: 16px; source: @image-url("../../../assets/ui/chevron-down.svg"); colorize: Theme.secondary; vertical-alignment: center; }
    }
    field := FocusScope { enabled: root.enabled;
        key-pressed(e) => {
            Theme.keyboard-focus=true;
            if e.text == Key.Return || e.text == " " || e.text == Key.DownArrow { root.show(); return accept; }
            return reject;
        }
    }
    mouse := TouchArea { enabled: root.enabled; clicked => { Theme.keyboard-focus=false; field.focus(); root.show(); } }
    options := PopupWindow { x: 0px; y: root.height + 4px; width: root.width; height: min(7,root.model.length) * 38px + 8px;
        close-policy: close-on-click-outside;
        forward-focus: menu;
        Rectangle { background: Theme.light ? #f5faf7 : #183039; border-width: 1px; border-color: Theme.border; border-radius: Theme.radius; }
        menu := FocusScope {
            focus-changed-event => { root.popup-open=self.has-focus; }
            key-pressed(e) => {
                Theme.keyboard-focus=true;
                if e.text == Key.Escape { root.popup-open=false; options.close(); field.focus(); return accept; }
                if e.text == Key.Tab { root.popup-open=false; options.close(); return reject; }
                if e.text == Key.DownArrow { root.pending=min(root.model.length - 1,root.pending + 1); return accept; }
                if e.text == Key.UpArrow { root.pending=max(0,root.pending - 1); return accept; }
                if e.text == Key.Return || e.text == " " { root.choose(); return accept; }
                return reject;
            }
            ScrollView { content-y: -max(0,root.pending - 5)*38px;
                VerticalLayout { padding: 4px; spacing: 0px;
                    for value[index] in root.model: Rectangle { height: 38px; border-radius: 5px;
                        accessible-role: button; accessible-label: value;
                        accessible-action-default => { root.pending=index; root.choose(); }
                        background: hit.has-hover || root.pending == index ? Theme.selection : transparent;
                        Text { x: 10px; width: parent.width - 20px; height: parent.height; text: value; color: Theme.text; vertical-alignment: center; overflow: elide; }
                        hit := TouchArea { clicked => { Theme.keyboard-focus=false; root.pending=index; root.choose(); } }
                    }
                }
            }
        }
    }
}
component ContentItem inherits Rectangle {
    in property <ContentRow> item;
    in property <bool> selected;
    in property <bool> enabled: true;
    callback clicked();
    height: 82px; background: hit.has-hover ? Theme.hover : selected ? Theme.selection : Theme.control;
    border-radius: 10px; border-width: field.has-focus && Theme.keyboard-focus ? 1px : 0px; border-color: Theme.focus;
    accessible-role: button; accessible-label: item.title + " · " + item.description; accessible-enabled: enabled;
    accessible-action-default => { if enabled { root.clicked(); } }
    Rectangle { x: 12px; y: 14px; width: 48px; height: 48px; border-radius: 10px; background: Theme.selection;
        if root.item.has-icon: Image { x: 4px; y: 4px; width: 40px; height: 40px; source: root.item.icon; image-fit: contain; }
        if !root.item.has-icon: Text { text: root.item.initial; color: Theme.accent; font-size: 16px; font-weight: 600; overflow: elide; horizontal-alignment: center; vertical-alignment: center; }
    }
    Text { x: 76px; y: 10px; width: parent.width - (root.item.downloaded ? 184px : 96px); height: 22px; text: root.item.title; font-size: 16px; font-weight: 600; color: Theme.text; overflow: elide; }
    if root.item.downloaded: Text { x: parent.width - 90px; y: 10px; width: 76px; height: 22px; text: @tr("已下载"); color: Theme.accent; font-size: 12px; horizontal-alignment: right; }
    Text { x: 76px; y: 35px; width: parent.width - 96px; height: 20px; text: root.item.description; font-size: 13px; color: Theme.secondary; overflow: elide; }
    Text { x: 76px; y: 57px; width: parent.width - 96px; height: 18px; text: root.item.meta; font-size: 12px; color: Theme.accent; overflow: elide; }
    field := FocusScope { enabled: root.enabled; key-pressed(e) => { if e.text == Key.Return || e.text == " " { root.clicked(); return accept; } return reject; } }
    hit := TouchArea { enabled: root.enabled; clicked => { field.focus(); root.clicked(); } }
}
component ContentVersionItem inherits Rectangle {
    in property <ContentVersionRow> item; in property <bool> selected; in property <bool> enabled: true;
    callback clicked();
    height: 70px; border-radius: Theme.radius;
    background: mouse.has-hover ? Theme.hover : root.selected ? Theme.selection : Theme.control;
    border-width: root.selected ? 1px : 0px; border-color: Theme.accent;
    accessible-role: button; accessible-label: item.title + " " + item.details; accessible-enabled: enabled;
    accessible-action-default => {if enabled {root.clicked();}}
    Text { x: 16px; y: 12px; height: 24px; width: parent.width - 128px; text: root.item.title; font-size: 16px; color: root.item.compatible ? Theme.text : Theme.disabled; overflow: elide; }
    Text { x: 16px; y: 40px; height: 18px; width: parent.width - 32px; text: root.item.details; font-size: 12px; color: Theme.secondary; overflow: elide; }
    Text { x: parent.width - 104px; y: 14px; width: 88px; height: 20px; text: root.item.downloaded ? @tr("已下载") : root.item.recommended ? @tr("推荐版本") : root.item.compatible ? "" : @tr("不适配"); color: Theme.accent; horizontal-alignment: right; }
    FocusScope {enabled: root.enabled; key-pressed(e) => {if e.text==Key.Return || e.text==" " {root.clicked();return accept;}return reject;}}
    mouse := TouchArea {enabled: root.enabled; clicked => {root.clicked();}}
}
component InstanceIcon inherits Rectangle {
    in property <string> icon: "grass";
    background: #8bdac016; border-radius: Theme.radius;
    Image { x: 6px; y: 6px; width: parent.width - 12px; height: parent.height - 12px; image-fit: contain;
        source: root.icon == "anvil" ? @image-url("../../../assets/instance-icons/anvil.svg") : root.icon == "pickaxe" ? @image-url("../../../assets/instance-icons/pickaxe.svg") : root.icon == "dirt" ? @image-url("../../../assets/instance-icons/dirt.svg") : @image-url("../../../assets/instance-icons/grass.png");
        colorize: root.icon == "grass" ? transparent : Theme.accent;
    }
}
// Reuse one blurred full-scene texture; offsets keep the frosted view aligned on resize.
component Glass inherits Rectangle {
    in property <length> viewport-width;
    in property <length> viewport-height;
    in property <length> scene-x;
    in property <length> scene-y;
    in property <color> tint: Theme.glass;
    property <float> cached-x;
    property <float> cached-y;
    property <float> cached-width;
    property <float> cached-height;
    property <float> cached-vw;
    property <float> cached-vh;
    function capture() {
        cached-x = scene-x / 1px; cached-y = scene-y / 1px;
        cached-width = self.width / 1px; cached-height = self.height / 1px;
        cached-vw = viewport-width / 1px; cached-vh = viewport-height / 1px;
    }
    function defer-texture() { settle.start(); settle.restart(); }
    init => { capture(); }
    changed width => { defer-texture(); }
    changed height => { defer-texture(); }
    changed scene-x => { defer-texture(); }
    changed scene-y => { defer-texture(); }
    changed viewport-width => { defer-texture(); }
    changed viewport-height => { defer-texture(); }
    settle := Timer { interval: 140ms; running: false; triggered => { root.capture(); self.stop(); } }
    border-radius: 15px; clip: true;
    Image { x: 0px; y: 0px; width: parent.width; height: parent.height;
        source: GlassAssets.ready ? GlassAssets.tile(root.cached-x, root.cached-y, root.cached-width, root.cached-height, root.cached-vw, root.cached-vh, GlassAssets.revision) : @image-url("");
        image-fit: fill;
    }
    Rectangle { x: 0px; y: 0px; width: parent.width; height: parent.height; background: root.tint; border-radius: 15px; border-width: 1px; border-color: Theme.border; }
    @children
}

export component Launcher inherits Window {
    init => { Palette.color-scheme = Theme.light ? light : dark; }
    title: @tr("AmberL · 开发预览");
    no-frame: true; resize-border-width: 10px;
    callback resize-window(); callback move-window();
    callback minimize(); callback maximize();
    in property <bool> window-maximized;
    callback appearance(bool);
    callback language(bool);
    in-out property <image> background-image: @image-url("../../../assets/launcher/forest-lake.png");
    in-out property <string> accent-input: "#62d6b4";
    in property <string> background-name;
    in property <bool> appearance-busy;
    callback set-accent(string); callback choose-background(); callback reset-background();
    public function apply-appearance(use-light: bool) {
        Theme.light = use-light;
        Palette.color-scheme = use-light ? light : dark;
    }
    background: #171c20; default-font-family: "Microsoft YaHei UI"; default-font-size: 16px;
    preferred-width: 1280px; preferred-height: 820px; min-width: 800px; min-height: 500px;
    in property <[GameRow]> games;
    in property <string> selected-id;
    in property <string> game-title: @tr("你的下一段冒险");
    in property <string> game-subtitle: @tr("安装游戏，或添加已有游戏库");
    in property <string> status;
    in property <string> task-log;
    in property <string> device-prompt;
    in property <string> device-code;
    in property <string> login-status;
    in property <bool> login-active;
    in property <int> login-remaining;
    in-out property <string> clipboard-notice;
    in property <string> task-title;
    in property <int> task-state;
    in-out property <bool> show-task-details: false;
    callback cancel-login(); callback copy-device-code();
    in property <bool> busy;
    in property <bool> running;
    in property <bool> launch-candidate;
    in property <bool> import-candidate;
    in property <bool> import-shared;
    in property <bool> import-modded;
    in-out property <bool> import-mods-acknowledged: false;
    in property <string> library-details;
    in-out property <string> import-parent;
    in-out property <string> import-name;
    in-out property <bool> import-acknowledged: false;
    callback import-game();
    in property <string> status-help;
    in property <string> network-help;
    in property <string> update-info;
    in property <bool> update-available;
    callback check-update();
    callback open-release();
    in property <[string]> account-options;
    in property <string> account-label: @tr("登录微软账户");
    in-out property <int> account-index: 0;
    in property <[string]> java-options;
    in-out property <int> java-index: 0;
    in-out property <string> java-path;
    in-out property <int> memory-mib: 4096;
    in-out property <string> library-path;
    in-out property <string> install-parent;
    in property <[string]> install-locations;
    in-out property <int> install-location-index: -1;
    callback choose-install-location(int);
    in-out property <string> install-name;
    in-out property <string> install-version;
    in property <[VersionRow]> versions;
    in-out property <string> version-search;
    in-out property <int> version-filter: 0;
    in-out property <int> install-step: 0;
    in-out property <string> install-title;
    in-out property <string> install-icon: "grass";
    in-out property <string> loader-kind: "原版";
    in property <[string]> loader-options;
    in-out property <int> loader-index: -1;
    callback load-versions(); callback filter-versions(); callback pick-version(string); callback pick-loader(string);
    in-out property <int> budget-gib: 4;
    public function begin-install() {
        install-step=0; install-version=""; loader-kind="原版"; loader-index=-1;
        install-title="";install-name="";install-icon="grass";version-search="";version-filter=0;
        panel=4;filter-versions();if versions.length == 0 {load-versions();}
    }
    in-out property <int> panel: 0;
    private property <float> reveal: 1;
    private property <bool> entering: true;
    animate reveal { duration: Theme.motion && root.entering ? 180ms : 0ms; easing: ease-out; }
    changed panel => { if panel != 4 { install-step=0;install-version="";loader-kind="原版";loader-index=-1;} entering = false; reveal = 0; reveal-timer.running = true; }
    reveal-timer := Timer { interval: 16ms; running: false; triggered => { root.entering = true; root.reveal = 1; self.running = false; } }
    callback select-game(string); callback refresh(); callback add-library(); callback install-game();
    callback login(); callback logout(); callback open-microsoft(); callback discover-java();
    in-out property <int> java-download-index: 4;
    callback install-java();
    callback choose-account(int); callback choose-java(int); callback launch(); callback cancel(); callback open-folder();
    in property <[string]> memory-options;
    in-out property <int> memory-index: 2;
    callback choose-memory(int);
    callback save-config(); callback open-eula(); callback launch-join();
    in-out property <int> network-tab: 0;
    in property <[string]> server-options; in-out property <int> server-index: -1;
    in property <[string]> server-versions; in-out property <int> server-version-index: -1;
    in-out property <string> server-loader-kind: "原版";
    in-out property <int> server-loader-kind-index: 0;
    in property <[string]> server-loader-options; in-out property <int> server-loader-index: -1;
    callback load-server-loaders();
    in property <bool> network-busy; in property <bool> server-active; in property <bool> room-active; in property <bool> component-ready;
    in property <bool> frp-active; in property <bool> frp-ready;
    in property <string> frp-status;
    in-out property <string> frp-server;
    in-out property <string> frp-certificate;
    in-out property <string> frp-token;
    in-out property <int> frp-local-port: 25565;
    in-out property <int> frp-remote-port: 25565;
    callback load-frp(); callback install-frp(); callback start-frp(); callback stop-frp();
    in property <string> network-status; in property <string> server-status; in property <string> room-status; in property <string> query-status;
    in property <string> server-log; in property <string> room-invite; in property <string> room-address;
    in-out property <string> server-name: @tr("好友的世界"); in-out property <int> server-port: 25565; in-out property <int> server-memory: 2048; in-out property <bool> server-eula: false;
    in-out property <string> console-command;
    in-out property <int> host-port: 25565; in-out property <int> guest-port: 25567;
    in-out property <string> room-peer: "tcp://public.easytier.top:11010";
    in-out property <string> invite-input; in-out property <string> join-target;
    callback refresh-servers(); callback create-server(); callback choose-server(int); callback start-server(); callback stop-server(); callback server-command();
    callback install-network(); callback host-room(); callback join-room(); callback leave-room(); callback probe-server();
    in property <[string]> backup-options; in-out property <int> backup-index: -1;
    in property <[string]> archived-options; in-out property <int> archived-index: -1;
    in-out property <string> restore-name: @tr("恢复的世界"); in-out property <int> restore-port: 25568;
    callback backup-server(); callback restore-backup(); callback archive-server(); callback restore-archived();
    callback load-server-config(); callback save-server-config(); callback recover-server-config();
    in property <bool> server-config-ready: false;
    in-out property <string> server-motd;
    in-out property <int> server-players: 8;
    in-out property <int> server-distance: 8;
    in-out property <string> server-difficulty: "easy";
    in-out property <string> server-mode: "survival";
    in property <string> content-destination;
    in property <string> content-target; in property <string> content-preview;
    in property <bool> content-server;
    in-out property <bool> content-match-game: true;
    in-out property <bool> content-match-loader: true;
    in property <bool> maintenance-has-target;
    in property <string> maintenance-target;
    in-out property <string> maintenance-name;
    in-out property <int> maintenance-icon: 0;
    in-out property <int> maintenance-tab: 0;
    in property <[string]> client-backups;
    in property <[string]> archived-games;
    in-out property <int> client-backup-index: -1;
    in-out property <int> archived-game-index: -1;
    in-out property <string> client-restore-parent;
    in-out property <string> client-restore-name: "recovered-game";
    callback open-maintenance(); callback save-instance(); callback archive-instance();
    callback backup-instance(); callback restore-instance(); callback unarchive-instance();
    in property <[ContentRow]> content-projects; in property <[string]> content-versions; in property <[ContentRow]> content-groups;
    in property <int> content-offset; in property <int> content-total;
    in property <bool> content-loaded;
    in-out property <int> content-sort: 0;
    callback content-page(int); callback refresh-content();
    in-out property <string> installed-query;
    in-out property <int> installed-filter: 0;
    in-out property <int> installed-page: 0;
    in property <int> installed-total;
    in property <string> installed-details;
    callback filter-installed(); callback select-installed(int);
    in-out property <string> content-project-title; in-out property <string> content-project-description;
    in property <[string]> content-group-states;
    in property <[OptionalRow]> content-optional;
    in property <[OptionalRow]> content-required;
    in property <[PlanRow]> content-plan-files;
    in property <int> content-skipped-required;
    in property <string> content-plan-summary;
    in property <[ContentVersionRow]> content-version-rows;
    in property <[ContentVersionGroup]> content-version-groups;
    in property <[ContentVersionRow]> content-recommendations;
    in-out property <string> content-expanded-group;
    in property <int> content-recommended-index: -1;
    callback select-required(int,bool);
    callback select-optional(int, bool);
    in-out property <int> content-project-index: -1; in-out property <int> content-version-index: -1; in-out property <int> content-group-index: -1;
    in-out property <int> content-kind-index: 0; in-out property <int> content-step: 0; in-out property <int> content-tab: 0;
    in-out property <string> content-query; in property <bool> content-has-plan;
    callback open-content(bool); callback search-content(); callback content-project(); callback preview-content(); callback install-content(); callback change-content(string);

    // Explicit origins prevent Slint's automatic child centering from shifting the scene.
    Image { x: 0px; y: 0px; width: root.width; height: root.height; source: root.background-image; image-fit: cover; }
    Rectangle { x: 0px; y: 0px; width: root.width; height: root.height; background: #081b2528; }
    TouchArea { pointer-event(event) => { if event.kind == down && event.button == left { root.move-window(); } } x: 6px; y: 6px; width: root.width - 12px; height: 84px; }
    if root.panel == 0: Rectangle {
        x: 0px; y: 0px; width: root.width; height: root.height; background: transparent; opacity: root.reveal;
        Glass {
            x: parent.width - 368px; y: 108px; width: 344px; height: min(root.height - 310px, 152px + max(1, root.games.length) * 84px);
            viewport-width: root.width; viewport-height: root.height; scene-x: self.x; scene-y: self.y;
            Text { vertical-stretch: 0; x: 20px; y: 20px; width: 220px; height: 30px; text: @tr("我的游戏"); color: Theme.text; font-size: 22px; font-weight: 600; }
            Action { x: parent.width - self.width - 16px; y: 16px; width: Locale.english ? 88px : 60px; height: 36px; label: @tr("刷新"); flat: true; enabled: !root.busy; clicked => { root.refresh(); } }
            if root.games.length == 0: Text { vertical-stretch: 0; x: 20px; y: 76px; width: parent.width - 40px; text: @tr("还没有游戏\n安装一个原版，或添加已有游戏库。"); color: Theme.secondary; font-size: 14px; wrap: word-wrap; }
            if root.games.length > 0: ListView {
                x: 12px; y: 68px; width: parent.width - 24px; height: parent.height - 136px;
                    for game in root.games: Rectangle {
                        height: 78px; border-radius: 10px;
                        background: root.selected-id == game.id ? Theme.selection : row-touch.has-hover ? Theme.border : transparent;
                        border-width: (row-focus.has-focus && Theme.keyboard-focus) || root.selected-id == game.id ? 1px : 0px; border-color: Theme.focus;
                        accessible-role: button; accessible-label: game.title + " " + game.subtitle; accessible-enabled: !root.busy;
                        accessible-action-default => { if !root.busy { root.select-game(game.id); } }
                        InstanceIcon { x: 12px; y: 12px; width: 54px; height: 54px; icon: game.icon; }
                        Text { vertical-stretch: 0; x: 80px; y: 14px; width: parent.width - 94px; height: 25px; text: game.title; color: Theme.text; font-size: 18px; font-weight: 600; overflow: elide; }
                        Text { vertical-stretch: 0; x: 80px; y: 43px; width: parent.width - 94px; height: 20px; text: game.subtitle; color: Theme.secondary; font-size: 12px; overflow: elide; }
                        row-focus := FocusScope { enabled: !root.busy; key-pressed(event) => { if !event.modifiers.alt && !event.modifiers.control && !event.modifiers.meta && (event.text == "\n" || event.text == " ") { root.select-game(game.id); return accept; } return reject; } }
                        row-touch := TouchArea { enabled: !root.busy; clicked => { row-focus.focus(); root.select-game(game.id); } }
                    }
            }
            HorizontalLayout { x: 16px; y: parent.height - 56px; width: parent.width - 32px; height: 40px; spacing: 8px;
                Action { height: 40px; label: @tr("安装游戏"); enabled: !root.busy; clicked => { root.begin-install(); } }
                Action { height: 40px; label: @tr("添加游戏库"); enabled: !root.busy; clicked => { root.panel=3; } }
            }
        }
        Rectangle { x: 48px; y: parent.height - 304px; width: parent.width - 464px; height: 144px; background: transparent;
            Text { vertical-stretch: 0; x: 0px; y: 0px; width: parent.width; height: 20px; text: "MINECRAFT / JAVA EDITION"; color: #c2dbd2; font-size: 12px; letter-spacing: 2px; }
            Text { vertical-stretch: 0; x: 0px; y: 31px; width: parent.width; height: 70px; text: root.game-title; color: #f3f6ee; font-size: root.width < 1150px ? 38px : 48px; font-weight: 700; overflow: elide; }
            Text { vertical-stretch: 0; x: 0px; y: 112px; width: parent.width; height: 26px; text: root.game-subtitle; color: #d0ded8; font-size: 16px; overflow: elide; }
        }
        Glass {
            x: 24px; y: parent.height - 136px; width: parent.width - 48px; height: 100px;
            viewport-width: root.width; viewport-height: root.height; scene-x: self.x; scene-y: self.y; tint: Theme.glass;
            Action { x: 18px; y: 22px; width: 180px; height: 56px; hint: @tr("微软账户"); label: root.account-label; clicked => { root.panel=1; } }
            Action { x: 208px; y: 22px; width: 140px; height: 56px; hint: @tr("JAVA 运行环境"); label: root.java-path == "" ? @tr("选择 Java") : @tr("已选择 Java"); enabled: !root.busy; clicked => { root.panel=2; } }
            Action { x: 358px; y: 22px; width: 132px; height: 56px; hint: @tr("最大内存"); label: root.memory-mib + " MiB"; enabled: !root.busy; clicked => { root.panel=2; } }
            if root.width >= 960px: Action { x: parent.width - 236px - self.width; y: 22px; width: Locale.english ? 108px : 76px; height: 56px; label: @tr("配置"); flat: true; enabled: !root.busy; clicked => { root.panel=2; } }
            Action { x: parent.width - 226px; y: 22px; width: 208px; height: 56px; primary: true; label: root.running ? @tr("游戏运行中") : root.busy ? @tr("正在处理…") : @tr("启动游戏");
                enabled: !root.busy && root.launch-candidate && root.account-index > 0 && root.java-path != "";
                clicked => { root.launch(); }
            }
        }
        if root.status != "": Text { vertical-stretch: 0; x: 30px; y: parent.height - 27px; width: parent.width - 60px; height: 20px; text: root.status; color: #a7c0bd; font-size: 12px; overflow: elide; }
    }
    if root.panel != 0: Rectangle {
        x: 0px; y: 0px; width: root.width; height: root.height; background: root.panel == 6 ? transparent : #07151b64;
        if root.panel != 6: TouchArea { }
        Glass { x: root.panel == 6 ? 24px : (parent.width - self.width)/2; y: 108px; opacity: root.reveal; width: root.panel == 6 ? parent.width - 48px : min(root.panel == 8 ? 1160px : 720px,parent.width - 80px);
            height: root.panel == 6 ? parent.height - 132px : min(root.panel == 8 ? 900px : root.panel == 4 && root.install-step == 1 && root.loader-kind == "原版" ? 480px : root.panel == 3 ? 360px : root.panel == 10 ? 760px : root.panel == 7 ? 400px : root.panel == 1 && root.device-prompt == "" ? 366px : root.panel == 2 ? 600px : 640px, parent.height - 132px);
            viewport-width: root.width; viewport-height: root.height; scene-x: self.x; scene-y: self.y; tint: Theme.dialog;
                    if root.panel == 6: VerticalLayout { x: 20px; y: 20px; width: 172px; height: root.height < 640px ? 300px : 356px; spacing: 8px;
                        Action { height: root.height < 640px ? 36px : 44px; leading: true; label: @tr("服务端"); selected: root.network-tab == 0; clicked => { root.network-tab=0; } }
                        Action { height: root.height < 640px ? 36px : 44px; leading: true; label: @tr("创建服务端"); selected: root.network-tab == 1; clicked => { root.network-tab=1; if root.server-versions.length == 0 && !root.busy { root.load-versions(); } } }
                        Action { height: root.height < 640px ? 36px : 44px; leading: true; label: @tr("邀请房间"); selected: root.network-tab == 2; clicked => { root.network-tab=2; } }
                        Action { height: root.height < 640px ? 36px : 44px; leading: true; label: @tr("加入游戏"); selected: root.network-tab == 3; clicked => { root.network-tab=3; } }
                        Action { height: root.height < 640px ? 36px : 44px; leading: true; label: @tr("控制台"); selected: root.network-tab == 4; clicked => { root.network-tab=4; } }
                        Action { height: root.height < 640px ? 36px : 44px; leading: true; label: @tr("备份恢复"); selected: root.network-tab == 5; clicked => { root.network-tab=5; root.refresh-servers(); } }
                        Action { height: root.height < 640px ? 36px : 44px; leading: true; label: "FRP"; selected: root.network-tab == 7; clicked => { root.network-tab=7; root.load-frp(); } }
                    }

            ScrollView { x: root.panel == 6 ? 196px : 0px; width: min(parent.width - self.x, root.panel == 6 ? 1120px : parent.width); height: parent.height; content-width: self.width;
            property <int> current-page: root.panel * 10000 + (root.panel == 6 ? root.network-tab : root.panel == 8 ? root.content-tab * 1000 + root.content-step * 100 + root.content-offset + root.installed-page : 0);
            changed current-page => { self.content-y = 0px; }
            VerticalLayout { alignment: start; padding: root.height < 760px ? 24px : 32px; spacing: root.height < 760px ? 12px : 16px;
                HorizontalLayout { height: 44px; spacing: 24px;
                    Text { vertical-stretch: 0; vertical-alignment: center; text: root.panel == 1 ? @tr("微软账户") : root.panel == 2 ? @tr("启动配置") : root.panel == 3 ? @tr("添加游戏库") : root.panel == 4 ? @tr("安装游戏") : root.panel == 5 ? @tr("当前任务") : root.panel == 6 ? (root.network-tab == 0 ? @tr("服务端") : root.network-tab == 1 ? @tr("创建服务端") : root.network-tab == 2 ? @tr("邀请房间") : root.network-tab == 3 ? @tr("加入游戏") : root.network-tab == 4 ? @tr("控制台") : root.network-tab == 5 ? @tr("备份恢复") : "FRP") : root.panel == 8 ? @tr("内容管理") : root.panel == 9 ? @tr("实例与备份") : root.panel == 10 ? @tr("设置") : root.panel == 11 ? @tr("游戏库详情与副本") : @tr("关于 AmberL"); color: Theme.text; font-size: 28px; font-weight: 600; }
                    Action { width: Locale.english ? 150px : 100px; label: root.panel == 8 && root.content-server ? @tr("返回联机") : @tr("返回游戏"); clicked => { root.panel=root.panel == 8 && root.content-server ? 6 : 0; } }
                }
                if root.panel == 1: VerticalLayout {
                    vertical-stretch: 0;
                    spacing: 16px;
                    Text { vertical-stretch: 0; text: @tr("登录由微软官方网页完成。账户保存在当前 Windows 用户的安全存储中。"); wrap: word-wrap; color: Theme.secondary; }
                    Text { vertical-stretch: 0; text: @tr("当前账户"); color: Theme.text; font-size: 13px; }
                    ComboBox { height: 40px; model: root.account-options; current-index <=> root.account-index; enabled: !root.busy; selected(value) => { root.choose-account(self.current-index); } }
                    HorizontalLayout { spacing: 12px; height: 44px;
                        Action { label: @tr("登录微软账户"); enabled: !root.login-active; clicked => { root.login(); } }
                        Action { label: @tr("退出所选账户"); enabled: !root.busy && !root.login-active && root.account-index > 0; clicked => { root.logout(); } }
                    }
                    if root.login-status != "": Text { text: root.login-status; wrap: word-wrap; color: Theme.accent; vertical-stretch: 0; }
                    if root.login-active: HorizontalLayout { height: 44px;
                        Action { label: @tr("取消登录"); clicked => { root.cancel-login(); } }
                        if root.device-code != "": Action { label: @tr("打开微软官方登录页面"); clicked => { root.open-microsoft(); } }
                    }
                    if root.device-code != "": HorizontalLayout { height: 44px; spacing: 12px;
                        Text { text: root.device-code; font-size: 28px; font-weight: 600; color: Theme.text; vertical-alignment: center; }
                        Action { label: @tr("复制设备码"); clicked => { root.copy-device-code(); } }
                    }
                    if root.device-code != "": Text { text: @tr("剩余时间（秒）：") + root.login-remaining + " · " + root.clipboard-notice; color: Theme.secondary; wrap: word-wrap; vertical-stretch: 0; }
                    if root.login-active: Text { text: @tr("未完成网页授权不会登录成功。你可以取消，或继续使用启动器的其他功能。"); color: Theme.secondary; wrap: word-wrap; vertical-stretch: 0; }
                    Text { vertical-stretch: 0; text: @tr("退出只移除本机登录信息，不退出已经运行的游戏。"); color: Theme.secondary; wrap: word-wrap; }
                }
                if root.panel == 2: VerticalLayout {
                    spacing: 12px;
                    Text { vertical-stretch: 0; text: @tr("为当前游戏保存 Java、账户选择和内存，重新打开后恢复。"); color: Theme.secondary; wrap: word-wrap; }
                    HorizontalLayout { height: 40px; spacing: 12px;
                        ComboBox { model: root.java-options; current-index <=> root.java-index; enabled: !root.busy; selected(value) => { root.choose-java(self.current-index); } }
                        Button { width: 140px; text: @tr("查找本机 Java"); enabled: !root.busy; clicked => { root.discover-java(); } }
                    }
                    HorizontalLayout { height: 40px; spacing: 12px;
                        ComboBox { model: ["Java 8", "Java 16", "Java 17", "Java 21", "Java 25"]; current-index <=> root.java-download-index; enabled: !root.busy; }
                        Button { text: @tr("下载官方 Java"); enabled: !root.busy; clicked => { root.install-java(); } }
                    }
                    Text { vertical-stretch: 0; text: @tr("Java 可执行文件（java.exe）"); color: Theme.text; }
                    LineEdit { height: 40px; text <=> root.java-path; enabled: !root.busy; accessible-label: @tr("Java 可执行文件"); }
                    HorizontalLayout { spacing: 16px; height: 40px; Text { vertical-stretch: 0; vertical-alignment: center; text: @tr("最大内存（MiB）"); color: Theme.text; } ComboBox { model: root.memory-options; current-index <=> root.memory-index; enabled: !root.busy; selected(value) => { root.choose-memory(self.current-index); } } }
                    HorizontalLayout { height: 44px; spacing: 12px;
                        Button { height: 44px; text: @tr("打开游戏目录"); enabled: root.selected-id != ""; clicked => { root.open-folder(); } }
                        Button { height: 44px; text: @tr("模组与资源"); enabled: !root.busy && root.launch-candidate; clicked => { root.open-content(false); } }
                        Button { height: 44px; text: @tr("保存启动配置"); enabled: !root.busy && root.selected-id != ""; clicked => { root.save-config(); } }
                    }
                    Text { vertical-stretch: 0; text: @tr("只启动 AmberL 创建的完整安装。启动前重新校验文件、账户与 Java；外部游戏库保持只读。"); color: Theme.secondary; wrap: word-wrap; }
                    Action { height: 40px; label: root.selected-id != "" && !root.launch-candidate ? @tr("游戏库详情与副本") : @tr("实例与备份"); enabled: !root.busy; clicked => { if root.selected-id != "" && !root.launch-candidate { root.import-acknowledged=false; root.import-mods-acknowledged=false; root.panel=11; } else { root.open-maintenance(); } } }
                }
                if root.panel == 11: VerticalLayout { vertical-stretch: 0; spacing: 10px;
                    Text { text: root.game-title + " · " + root.game-subtitle; color: Theme.text; font-size: 14px; overflow: elide; }
                    TextEdit { height: 90px; font-size: 13px; text: root.library-details; read-only: true; accessible-label: @tr("来源路径与隔离证据"); }
                    Text { text: root.import-candidate ? @tr("可创建独立副本；游戏和加载器从官方来源重建，原库保持只读。") : @tr("仅可查看。游戏、加载器或隔离位置尚未确认，请在原启动器核对后重新扫描。"); color: Theme.secondary; font-size: 12px; wrap: word-wrap; }
                    Text { text: @tr("复制存档、资源包、截图和设置，不复制账户或启动器配置。模组实例还会复制模组与脚本。总计最多 16 GiB，请先关闭来源游戏。"); color: Theme.secondary; font-size: 12px; wrap: word-wrap; }
                    Text { text: @tr("副本父目录 · 与原库分离的已有文件夹"); color: Theme.text; font-size: 13px; }
                    LineEdit { height: 36px; text <=> root.import-parent; enabled: root.import-candidate && !root.busy; accessible-label: @tr("副本父目录"); }
                    Text { text: @tr("副本名称（同时作为新文件夹名）"); color: Theme.text; font-size: 13px; }
                    LineEdit { height: 36px; text <=> root.import-name; enabled: root.import-candidate && !root.busy; accessible-label: @tr("副本文件夹名称"); }
                    if root.import-modded: Text { text: @tr("模组和脚本将在游戏中执行，请仅导入可信来源。Forge / NeoForge 需要兼容的 Java 才能重建。"); color: Theme.secondary; font-size: 12px; wrap: word-wrap; }
                    if root.import-modded: CheckBox { text: @tr("信任来源并复制模组与脚本"); checked <=> root.import-mods-acknowledged; enabled: !root.busy; }
                    if root.import-modded: LineEdit { height: 36px; text <=> root.java-path; placeholder-text: @tr("Java 可执行文件（java.exe）"); accessible-label: @tr("Java 可执行文件"); enabled: !root.busy; }
                    if root.import-shared: CheckBox { text: @tr("确认复制共享目录的全部存档与设置"); checked <=> root.import-acknowledged; enabled: !root.busy; }
                    Action { height: 44px; label: @tr("创建独立副本"); selected: true; enabled: root.import-candidate && !root.busy && root.import-parent != "" && root.import-name != "" && (!root.import-shared || root.import-acknowledged) && (!root.import-modded || root.import-mods-acknowledged); clicked => { root.import-game(); } }
                }
                if root.panel == 3: VerticalLayout {
                    spacing: 18px;
                    Text { vertical-stretch: 0; text: @tr("填写一个已有文件夹，将它加入安装位置列表。已有游戏库还会登记并扫描；原文件不会移动或覆盖。"); color: Theme.secondary; wrap: word-wrap; }
                    LineEdit { height: 40px; text <=> root.library-path; placeholder-text: @tr("游戏库完整路径"); accessible-label: @tr("游戏库完整路径"); enabled: !root.busy; }
                    Button { text: @tr("登记并扫描"); enabled: !root.busy && root.library-path != ""; clicked => { root.add-library(); } }
                }
                if root.panel == 4: VerticalLayout {
                    vertical-stretch: 0;
                    spacing: 14px;
                    HorizontalLayout { height: 32px; spacing: 8px;
                        Text { vertical-stretch: 0; text: @tr("01  游戏版本"); color: root.install-step == 0 ? Theme.accent : Theme.secondary; font-size: 13px; vertical-alignment: center; }
                        Text { vertical-stretch: 0; text: @tr("02  组件"); color: root.install-step == 1 ? Theme.accent : Theme.secondary; font-size: 13px; vertical-alignment: center; }
                        Text { vertical-stretch: 0; text: @tr("03  名称与位置"); color: root.install-step == 2 ? Theme.accent : Theme.secondary; font-size: 13px; vertical-alignment: center; }
                    }
                    if root.install-step == 0: VerticalLayout { spacing: 12px;
                        HorizontalLayout { height: 40px; spacing: 12px;
                            LineEdit { placeholder-text: @tr("搜索版本，例如 1.21.1"); text <=> root.version-search; edited => { root.filter-versions(); } accessible-label: @tr("搜索游戏版本"); }
                            ComboBox { width: 128px; model: [@tr("正式版"), @tr("快照版"), @tr("历史版本"), @tr("全部版本")]; current-index <=> root.version-filter; selected(value) => { root.filter-versions(); } }
                            Action { width: 76px; height: 40px; label: @tr("刷新"); enabled: !root.busy; clicked => { root.load-versions(); } }
                        }
                        Rectangle { height: max(120px,min(260px, root.height - 520px)); border-radius: 10px; background: Theme.inset; border-width: 1px; border-color: Theme.border;
                            ListView { x: 8px; y: 8px; width: parent.width - 16px; height: parent.height - 16px;
                                for version in root.versions: Action { height: 44px; label: version.id; leading: true; selected: root.install-version == version.id; flat: true; enabled: !root.busy; clicked => { root.pick-version(version.id); } }
                            }
                            if root.versions.length == 0: Text { vertical-stretch: 0; x: 20px; y: 100px; width: parent.width - 40px; text: root.busy ? @tr("正在读取官方版本列表…") : @tr("没有匹配的版本，可清除搜索或重试刷新。"); horizontal-alignment: center; color: Theme.secondary; font-size: 14px; }
                        }
                        HorizontalLayout { height: 44px; spacing: 12px;
                            Text { vertical-stretch: 0; text: root.install-version == "" ? @tr("从列表选择一个游戏版本") : @tr("已选择 Minecraft ") + root.install-version; color: Theme.secondary; font-size: 14px; vertical-alignment: center; }
                            Action { width: 148px; label: @tr("下一步 · 组件"); selected: true; enabled: !root.busy && root.install-version != ""; clicked => { root.install-step=1; } }
                        }
                    }
                    if root.install-step == 1: VerticalLayout { spacing: 18px;
                        Text { vertical-stretch: 0; text: "Minecraft " + root.install-version; color: Theme.text; font-size: 20px; }
                        Text { vertical-stretch: 0; text: @tr("选择一个加载器，或保留原版。列表来自对应项目的官方来源。"); color: Theme.secondary; wrap: word-wrap; font-size: 14px; }
                        HorizontalLayout { height: 44px; spacing: 8px;
                            for kind in ["原版", "Fabric", "Forge", "Quilt", "NeoForge"]: Action { label: kind == "原版" ? @tr("原版") : kind; selected: root.loader-kind == kind; enabled: !root.busy; clicked => { root.pick-loader(kind); } }
                        }
                        if root.loader-kind != "原版": VerticalLayout { spacing: 8px;
                            Text { vertical-stretch: 0; text: root.loader-kind + @tr(" 版本"); color: Theme.text; font-size: 13px; }
                            ComboBox { height: 40px; model: root.loader-options; current-index <=> root.loader-index; enabled: !root.busy; }
                            Text { vertical-stretch: 0; text: root.busy ? @tr("正在读取兼容版本…") : root.loader-options.length == 0 ? @tr("该游戏版本暂无可用结果，可切换加载器或重试。") : @tr("安装时会再次核验兼容关系与下载文件。"); wrap: word-wrap; color: Theme.secondary; font-size: 13px; }
                        }
                        Text { vertical-stretch: 0; text: root.loader-kind == "Forge" || root.loader-kind == "NeoForge" ? @tr("需要先在启动配置中选择匹配的 Java。旧式 Forge 安装器暂不支持。") : root.loader-kind == "原版" ? @tr("不安装额外加载器，直接使用 Minecraft 原版客户端。") : @tr("仅安装加载器；Fabric API、QSL 等模组需按模组要求另行安装。"); color: Theme.secondary; wrap: word-wrap; font-size: 14px; }
                        HorizontalLayout { height: 44px; spacing: 12px;
                            Action { label: @tr("上一步"); enabled: !root.busy; clicked => { root.install-step=0; } }
                            Action { label: @tr("下一步 · 名称与位置"); selected: true; enabled: !root.busy && (root.loader-kind == "原版" || root.loader-index >= 0); clicked => { root.install-step=2; } }
                        }
                    }
                    if root.install-step == 2: VerticalLayout { spacing: root.height < 760px ? 8px : 12px;
                        HorizontalLayout { height: 64px; spacing: 16px;
                            InstanceIcon { width: 64px; height: 64px; icon: root.install-icon; }
                            VerticalLayout { spacing: 4px;
                                Text { vertical-stretch: 0; text: @tr("游戏名称"); color: Theme.text; font-size: 13px; }
                                LineEdit { height: 40px; text <=> root.install-title; accessible-label: @tr("游戏显示名称"); enabled: !root.busy; }
                            }
                        }
                        HorizontalLayout { height: 52px; spacing: 8px;
                            for icon in ["grass","dirt","anvil","pickaxe"]: Rectangle { border-radius: Theme.radius; border-width: 1px; border-color: root.install-icon == icon ? Theme.accent : Theme.border;
                                InstanceIcon { x: 8px; y: 6px; width: 40px; height: 40px; icon: icon; }
                                TouchArea { x: 0px; y: 0px; width: 48px; height: parent.height; enabled: !root.busy; clicked => { root.install-icon=icon; } }
                                Action { x: 48px; y: 4px; width: parent.width - 52px; height: 44px; label: icon == "grass" ? @tr("草方块") : icon == "dirt" ? @tr("土方块") : icon == "anvil" ? @tr("铁砧") : @tr("铁镐"); flat: true; enabled: !root.busy; clicked => { root.install-icon=icon; } }
                            }
                        }
                        VerticalLayout { spacing: 6px;
                            Text { vertical-stretch: 0; text: @tr("安装位置"); color: Theme.text; font-size: 13px; }
                            ComboBox { height: 40px; model: root.install-locations; current-index <=> root.install-location-index; enabled: !root.busy; selected(value) => { root.choose-install-location(self.current-index); } }
                            Text { text: root.install-parent; color: Theme.secondary; wrap: word-wrap; vertical-stretch: 0; }
                            Action { label: @tr("添加安装位置或游戏库"); enabled: !root.busy; clicked => { root.panel=3; } }
                        }
                        HorizontalLayout { spacing: 16px;
                            VerticalLayout { spacing: 6px;
                                Text { vertical-stretch: 0; text: @tr("独立文件夹名称"); color: Theme.text; font-size: 13px; }
                                LineEdit { height: 40px; text <=> root.install-name; enabled: !root.busy; accessible-label: @tr("新安装文件夹名称"); }
                            }
                            VerticalLayout { width: 164px; spacing: 6px;
                                Text { vertical-stretch: 0; text: @tr("空间预算（GiB）"); color: Theme.text; font-size: 13px; }
                                SpinBox { height: 40px; value <=> root.budget-gib; minimum: 1; maximum: 128; enabled: !root.busy; }
                            }
                        }
                        Text { vertical-stretch: 0; text: "Minecraft " + root.install-version + " · " + (root.loader-kind == "原版" ? @tr("原版") : root.loader-kind) + @tr(" · 创建独立目录，不覆盖同名游戏。"); color: Theme.secondary; font-size: 13px; wrap: word-wrap; }
                        HorizontalLayout { height: 44px; spacing: 12px;
                            Action { width: 108px; label: @tr("上一步"); enabled: !root.busy; clicked => { root.install-step=1; } }
                            Action { label: @tr("下载并安装"); primary: true; enabled: !root.busy && root.install-parent != "" && root.install-title != "" && root.install-name != ""; clicked => { root.install-game(); } }
                        }
                    }
                }
                if root.panel == 5: VerticalLayout {
                    spacing: 16px; vertical-stretch: 0;
                    if root.login-active || root.login-status != "": Text { text: @tr("微软登录") + " · " + root.login-status; color: Theme.accent; wrap: word-wrap; vertical-stretch: 0; }
                    if root.login-active: HorizontalLayout { height: 44px; spacing: 12px;
                        Action { label: @tr("继续网页授权"); clicked => { root.panel=1; } }
                        Action { label: @tr("取消登录"); clicked => { root.cancel-login(); } }
                    }
                    if root.login-active && root.device-code != "": Text { text: @tr("剩余时间（秒）：") + root.login-remaining; color: Theme.secondary; vertical-stretch: 0; }
                    Text { text: root.task-title == "" ? @tr("暂无下载或游戏任务") : root.task-title; color: Theme.text; font-size: 22px; wrap: word-wrap; vertical-stretch: 0; }
                    Text { text: root.task-state == 1 ? root.status : root.task-state == 2 ? @tr("已完成") : root.task-state == 3 ? root.status : root.task-state == 4 ? @tr("已取消") : @tr("你可以安装游戏、管理内容，或前往联机。"); color: Theme.secondary; wrap: word-wrap; vertical-stretch: 0; }
                    if root.busy: Action { height: 44px; label: root.running ? @tr("请求游戏正常退出") : @tr("取消当前操作"); clicked => { root.cancel(); } }
                    if root.running: Text { vertical-stretch: 0; text: @tr("取消运行中的游戏会请求正常退出，请先保存世界。"); color: Theme.secondary; wrap: word-wrap; }
                    Action { height: 40px; label: root.show-task-details ? @tr("收起详细记录") : @tr("查看详细记录"); clicked => { root.show-task-details = !root.show-task-details; } }
                    if root.show-task-details: TextEdit { text: root.task-log; read-only: true; accessible-label: @tr("任务记录"); height: 180px; }
                }
                if root.panel == 6: VerticalLayout { spacing: 12px; vertical-stretch: 0;
                    if root.network-tab == 7: VerticalLayout { spacing: 12px;
                        Text { text: root.frp-status; color: Theme.accent; wrap: word-wrap; vertical-stretch: 0; }
                        Text { text: @tr("节点地址（主机:端口）"); color: Theme.secondary; vertical-stretch: 0; }
                        LineEdit { text <=> root.frp-server; placeholder-text: "frp.example.com:7000"; accessible-label: @tr("FRP 节点地址"); enabled: !root.frp-active && !root.network-busy; }
                        Text { text: @tr("节点 CA 证书（PEM 文件路径）"); color: Theme.secondary; vertical-stretch: 0; }
                        LineEdit { text <=> root.frp-certificate; accessible-label: @tr("FRP 节点证书"); enabled: !root.frp-active && !root.network-busy; }
                        LineEdit { text <=> root.frp-token; input-type: password; placeholder-text: @tr("节点令牌 · 留空使用已保存令牌"); accessible-label: @tr("FRP 节点令牌"); enabled: !root.frp-active && !root.network-busy; }
                        HorizontalLayout { height: 40px; spacing: 12px;
                            Text { text: @tr("本地游戏端口"); color: Theme.secondary; vertical-alignment: center; }
                            SpinBox { value <=> root.frp-local-port; minimum: 1024; maximum: 65535; enabled: !root.frp-active; }
                            Text { text: @tr("节点公开端口"); color: Theme.secondary; vertical-alignment: center; }
                            SpinBox { value <=> root.frp-remote-port; minimum: 1024; maximum: 65535; enabled: !root.frp-active; }
                        }
                        Text { text: @tr("启动后，节点会将公开端口转发到指定的本地游戏端口。FRP 与游戏、服务端独立启停；令牌保存在系统安全存储中。"); color: Theme.secondary; wrap: word-wrap; vertical-stretch: 0; }
                        HorizontalLayout { height: 40px; spacing: 12px;
                            Action { label: root.frp-ready ? @tr("校验 FRP 组件") : @tr("下载 FRP 组件"); enabled: !root.network-busy && !root.frp-active; clicked => { root.install-frp(); } }
                            Action { label: @tr("保存并启动"); selected: true; enabled: root.frp-ready && !root.network-busy && !root.frp-active && root.frp-server != "" && root.frp-certificate != ""; clicked => { root.start-frp(); } }
                            Action { label: @tr("停止 FRP"); enabled: root.frp-active; clicked => { root.stop-frp(); } }
                        }
                    }
                    if root.network-tab == 0: VerticalLayout { spacing: 16px;
                        Text { vertical-stretch: 0; text: @tr("我的独立服务端"); color: Theme.text; font-size: 14px; }
                        HorizontalLayout { height: 40px; spacing: 12px;
                            ComboBox { model: root.server-options; current-index <=> root.server-index; enabled: !root.server-active && !root.network-busy; selected(value) => { root.choose-server(self.current-index); } }
                            Action { width: 96px; label: @tr("刷新"); enabled: !root.network-busy; clicked => { root.refresh-servers(); } }
                        }
                        Text { vertical-stretch: 0; text: root.server-status; color: Theme.accent; wrap: word-wrap; }
                        HorizontalLayout { height: 40px; spacing: 16px;
                            Text { vertical-stretch: 0; text: @tr("服务端内存（MiB）"); color: Theme.text; vertical-alignment: center; }
                            SpinBox { value <=> root.server-memory; minimum: 512; maximum: 65536; enabled: !root.server-active; }
                            Action { width: 160px; label: @tr("选择 Java"); clicked => { root.panel=2; } }
                        }
                        Text { vertical-stretch: 0; text: root.java-path == "" ? @tr("请先选择兼容的 java.exe") : root.java-path; color: Theme.secondary; font-size: 13px; wrap: word-wrap; }
                        HorizontalLayout { height: 44px; spacing: 12px;
                            Action { label: @tr("启动服务端"); selected: true; enabled: !root.network-busy && !root.server-active && root.server-index >= 0 && root.java-path != ""; clicked => { root.start-server(); } }
                            Action { label: @tr("保存并停止"); enabled: root.server-active; clicked => { root.stop-server(); } }
                        }
                        Text { vertical-stretch: 0; text: @tr("服务端与游戏可同时运行。只监听本机，启用正版验证；使用邀请房间与朋友连接。"); color: Theme.secondary; wrap: word-wrap; font-size: 14px; }
                        HorizontalLayout { height: 40px; spacing: 12px;
                            Action { label: @tr("管理模组与插件"); enabled: !root.busy && !root.server-active && root.server-index >= 0; clicked => { root.open-content(true); } }
                            Action { label: @tr("服务端配置"); enabled: !root.network-busy && !root.server-active && root.server-index >= 0; clicked => { root.network-tab=6; root.load-server-config(); } }
                        }
                    }
                    if root.network-tab == 6: VerticalLayout { spacing: 12px;
                        Text { text: @tr("服务端配置 · 停服后保存"); color: Theme.text; vertical-stretch: 0; }
                        Text { text: @tr("服务器描述"); color: Theme.secondary; vertical-stretch: 0; }
                        LineEdit { text <=> root.server-motd; accessible-label: @tr("服务器描述"); enabled: root.server-config-ready && !root.network-busy; }
                        HorizontalLayout { height: 40px; spacing: 12px;
                            Text { text: @tr("人数上限"); color: Theme.secondary; vertical-alignment: center; }
                            SpinBox { value <=> root.server-players; minimum: 1; maximum: 1000; enabled: root.server-config-ready && !root.network-busy; }
                            Text { text: @tr("视距"); color: Theme.secondary; vertical-alignment: center; }
                            SpinBox { value <=> root.server-distance; minimum: 2; maximum: 32; enabled: root.server-config-ready && !root.network-busy; }
                        }
                        HorizontalLayout { height: 40px; spacing: 12px;
                            Text { text: @tr("难度"); color: Theme.secondary; vertical-alignment: center; }
                            ComboBox { model: ["peaceful", "easy", "normal", "hard"]; current-index: root.server-difficulty == "peaceful" ? 0 : root.server-difficulty == "easy" ? 1 : root.server-difficulty == "normal" ? 2 : 3; selected(value) => { root.server-difficulty=value; } enabled: root.server-config-ready && !root.network-busy; }
                            Text { text: @tr("模式"); color: Theme.secondary; vertical-alignment: center; }
                            ComboBox { model: ["survival", "creative", "adventure", "spectator"]; current-index: root.server-mode == "survival" ? 0 : root.server-mode == "creative" ? 1 : root.server-mode == "adventure" ? 2 : 3; selected(value) => { root.server-mode=value; } enabled: root.server-config-ready && !root.network-busy; }
                        }
                        Text { text: @tr("保存时检查外部修改，并保留恢复副本。若写入中断，先恢复配置再启动。"); color: Theme.secondary; wrap: word-wrap; vertical-stretch: 0; }
                        HorizontalLayout { height: 40px; spacing: 12px;
                            Action { label: @tr("重新读取"); enabled: !root.network-busy; clicked => { root.load-server-config(); } }
                            Action { label: @tr("保存配置"); selected: true; enabled: root.server-config-ready && !root.network-busy; clicked => { root.save-server-config(); } }
                            Action { label: @tr("恢复中断写入"); enabled: !root.network-busy; clicked => { root.recover-server-config(); } }
                        }
                    }
                    if root.network-tab == 1: VerticalLayout { spacing: 12px;
                        Text { vertical-stretch: 0; text: @tr("游戏版本与加载器"); color: Theme.text; font-size: 13px; }
                        HorizontalLayout { height: 40px; spacing: 12px;
                            ComboBox { model: root.server-versions; current-index <=> root.server-version-index; enabled: !root.network-busy; }
                            Action { width: 96px; label: @tr("更新列表"); enabled: !root.busy; clicked => { root.load-versions(); } }
                        }
                        HorizontalLayout { height: 40px; spacing: 12px;
                            ComboBox { width: 160px; model: [@tr("原版"), "Fabric", "Quilt", "Forge", "NeoForge", "Paper"]; current-index <=> root.server-loader-kind-index; enabled: !root.network-busy; selected(value) => { root.server-loader-kind=["原版", "Fabric", "Quilt", "Forge", "NeoForge", "Paper"][self.current-index]; } }
                            ComboBox { model: root.server-loader-options; current-index <=> root.server-loader-index; enabled: !root.network-busy && root.server-loader-kind != "原版"; }
                            Action { width: Locale.english ? 152px : 96px; label: @tr("加载器列表"); enabled: !root.network-busy && root.server-version-index >= 0 && root.server-loader-kind != "原版"; clicked => { root.load-server-loaders(); } }
                        }
                        Text { vertical-stretch: 0; text: @tr("名称与监听端口"); color: Theme.text; font-size: 13px; }
                        HorizontalLayout { height: 40px; spacing: 12px;
                            LineEdit { text <=> root.server-name; accessible-label: @tr("服务端名称"); enabled: !root.network-busy; }
                            SpinBox { width: 160px; value <=> root.server-port; minimum: 1024; maximum: 65535; enabled: !root.network-busy; }
                        }
                        Text { vertical-stretch: 0; text: @tr("存档保存在 AmberL 独立应用目录中。只新建服务端，不导入或覆盖现有世界。"); color: Theme.secondary; wrap: word-wrap; font-size: 14px; }
                        HorizontalLayout { height: 40px; spacing: 12px;
                            CheckBox { text: @tr("我已阅读并同意 Minecraft EULA"); checked <=> root.server-eula; enabled: !root.network-busy; }
                            Action { width: 100px; label: @tr("阅读 EULA"); flat: true; clicked => { root.open-eula(); } }
                        }
                        Action { label: @tr("下载并创建服务端"); selected: true; enabled: !root.network-busy && root.server-eula && root.server-version-index >= 0 && root.server-name != ""; clicked => { root.create-server(); } }
                    }
                    if root.network-tab == 2: VerticalLayout { spacing: 12px;
                        HorizontalLayout { height: 40px; spacing: 12px;
                            Text { vertical-stretch: 0; text: root.component-ready ? @tr("EasyTier 2.6.4 · 运行前校验") : @tr("下载联机组件后即可创建和加入房间"); color: Theme.secondary; vertical-alignment: center; font-size: 14px; }
                            Action { width: Locale.english ? 224px : 132px; label: @tr("下载联机组件"); enabled: !root.network-busy && !root.room-active; clicked => { root.install-network(); } }
                        }
                        Text { vertical-stretch: 0; text: @tr("连接节点（可修改为自己的 EasyTier 节点）"); color: Theme.text; font-size: 13px; }
                        LineEdit { height: 40px; text <=> root.room-peer; enabled: !root.room-active; accessible-label: @tr("EasyTier 连接节点"); }
                        HorizontalLayout { height: 40px; spacing: 12px;
                            Text { vertical-stretch: 0; text: @tr("共享本机 Minecraft 端口"); color: Theme.text; vertical-alignment: center; font-size: 14px; }
                            SpinBox { width: 140px; value <=> root.host-port; minimum: 1024; maximum: 65535; enabled: !root.room-active; }
                            Action { label: @tr("创建邀请"); enabled: root.component-ready && !root.room-active && !root.network-busy; clicked => { root.host-room(); } }
                        }
                        Text { vertical-stretch: 0; text: root.room-status; color: Theme.accent; wrap: word-wrap; font-size: 14px; }
                        TextEdit { height: 72px; text: root.room-invite; read-only: true; accessible-label: @tr("房间邀请，选择并复制给朋友"); }
                        HorizontalLayout { height: 40px; spacing: 12px;
                            Text { vertical-stretch: 0; text: @tr("邀请含加入密钥，24 小时有效，仅发给信任的朋友。关闭房间立即断开转发。"); color: Theme.secondary; wrap: word-wrap; font-size: 13px; }
                            Action { width: 128px; label: @tr("关闭房间"); enabled: root.room-active; clicked => { root.leave-room(); } }
                        }
                    }
                    if root.network-tab == 3: VerticalLayout { spacing: 10px;
                        Text { vertical-stretch: 0; text: @tr("粘贴 AmberL 邀请 · 需先在邀请房间页下载联机组件"); color: Theme.text; font-size: 13px; }
                        LineEdit { height: 40px; text <=> root.invite-input; enabled: !root.room-active; accessible-label: @tr("房间邀请码"); }
                        HorizontalLayout { height: 40px; spacing: 12px;
                            Text { vertical-stretch: 0; text: @tr("本地端口"); color: Theme.text; vertical-alignment: center; font-size: 14px; }
                            SpinBox { width: 140px; value <=> root.guest-port; minimum: 1024; maximum: 65535; enabled: !root.room-active; }
                            Action { label: @tr("连接房间"); enabled: root.component-ready && !root.room-active && !root.network-busy && root.invite-input != ""; clicked => { root.join-room(); } }
                            Action { label: @tr("离开"); enabled: root.room-active; clicked => { root.leave-room(); } }
                        }
                        Text { vertical-stretch: 0; text: root.room-status; color: Theme.accent; font-size: 13px; wrap: word-wrap; }
                        HorizontalLayout { height: 40px; spacing: 12px;
                            LineEdit { text <=> root.join-target; placeholder-text: @tr("服务器地址或房间本地地址"); accessible-label: @tr("加入游戏地址"); }
                            Action { width: Locale.english ? 170px : 128px; label: @tr("填入房间地址"); enabled: root.room-address != ""; clicked => { root.join-target=root.room-address; } }
                        }
                        Text { vertical-stretch: 0; text: root.query-status; color: Theme.secondary; font-size: 13px; wrap: word-wrap; }
                        HorizontalLayout { height: 44px; spacing: 12px;
                            Action { label: @tr("查询游戏状态"); enabled: root.join-target != ""; clicked => { root.probe-server(); } }
                            Action { label: @tr("启动所选游戏并加入"); selected: true; enabled: !root.busy && root.launch-candidate && root.account-index > 0 && root.java-path != "" && root.join-target != ""; clicked => { root.launch-join(); } }
                        }
                        Text { vertical-stretch: 0; text: @tr("使用游戏页所选版本、账户和启动配置。请与房主保持版本和模组一致；状态响应不代表已登录或进入世界。"); color: Theme.secondary; wrap: word-wrap; font-size: 13px; }
                    }
                    if root.network-tab == 4: VerticalLayout { spacing: 12px;
                        Text { vertical-stretch: 0; text: root.server-status; color: Theme.accent; font-size: 14px; wrap: word-wrap; }
                        TextEdit { height: max(120px,min(260px,root.height - 430px)); text: root.server-log; read-only: true; accessible-label: @tr("服务端控制台输出"); }
                        HorizontalLayout { height: 40px; spacing: 12px;
                            LineEdit { text <=> root.console-command; enabled: root.server-active; placeholder-text: @tr("输入单行服务端命令，例如 list"); accessible-label: @tr("服务端命令"); }
                            Action { width: 96px; label: @tr("发送"); enabled: root.server-active && root.console-command != ""; clicked => { root.server-command(); } }
                        }
                    }
                }
                if root.panel == 6 && root.network-tab == 5: VerticalLayout { spacing: 12px; vertical-stretch: 0;
                    Text { vertical-stretch: 0; text: @tr("停止服务端后备份整个世界与组件。恢复会创建新服务端，保留原世界。"); color: Theme.secondary; wrap: word-wrap; }
                    HorizontalLayout { height: 40px; spacing: 12px;
                        Action { label: @tr("备份所选服务端"); selected: true; enabled: !root.network-busy && !root.server-active && root.server-index >= 0; clicked => { root.backup-server(); } }
                        Action { label: @tr("移除所选服务端（可恢复）"); enabled: !root.network-busy && !root.server-active && root.server-index >= 0; clicked => { root.archive-server(); } }
                    }
                    Text { vertical-stretch: 0; text: @tr("选择备份 · 恢复为新服务端"); color: Theme.text; font-size: 13px; }
                    ComboBox { model: root.backup-options; current-index <=> root.backup-index; enabled: !root.network-busy; }
                    HorizontalLayout { height: 40px; spacing: 12px;
                        LineEdit { text <=> root.restore-name; accessible-label: @tr("恢复后的服务端名称"); enabled: !root.network-busy; }
                        SpinBox { width: 140px; value <=> root.restore-port; minimum: 1024; maximum: 65535; enabled: !root.network-busy; }
                        Action { width: 140px; label: @tr("校验并恢复"); enabled: !root.network-busy && root.backup-index >= 0 && root.backup-index < root.backup-options.length; clicked => { root.restore-backup(); } }
                    }
                    Text { vertical-stretch: 0; text: @tr("已移除的服务端 · 数据仍保留"); color: Theme.text; font-size: 13px; }
                    HorizontalLayout { height: 40px; spacing: 12px;
                        ComboBox { model: root.archived-options; current-index <=> root.archived-index; enabled: !root.network-busy; }
                        Action { width: 140px; label: @tr("恢复到列表"); enabled: !root.network-busy && root.archived-index >= 0 && root.archived-index < root.archived-options.length; clicked => { root.restore-archived(); } }
                    }
                }
                if root.panel == 9: VerticalLayout { spacing: 14px; vertical-stretch: 0;
                    HorizontalLayout { height: 40px; spacing: 12px;
                        Action { label: @tr("当前实例"); selected: root.maintenance-tab == 0; clicked => { root.maintenance-tab=0; } }
                        Action { label: @tr("备份与恢复"); selected: root.maintenance-tab == 1; clicked => { root.maintenance-tab=1; } }
                    }
                    if root.maintenance-tab == 0: VerticalLayout { spacing: 14px;
                        Text { text: root.maintenance-has-target ? root.maintenance-target : @tr("请先选择 AmberL 创建的游戏。已有备份和移除记录可在右侧查看。"); wrap: word-wrap; color: Theme.accent; }
                        Text { text: @tr("显示名称"); color: Theme.text; }
                        LineEdit { height: 40px; text <=> root.maintenance-name; accessible-label: @tr("实例显示名称"); enabled: !root.busy && root.maintenance-has-target; }
                        Text { text: @tr("图标"); color: Theme.text; }
                        ComboBox { model: [@tr("草方块"), @tr("泥土"), @tr("铁砧"), @tr("镐")]; current-index <=> root.maintenance-icon; enabled: !root.busy && root.maintenance-has-target; }
                        HorizontalLayout { height: 40px; spacing: 12px;
                            Action { label: @tr("保存名称与图标"); enabled: !root.busy && root.maintenance-has-target; clicked => { root.save-instance(); } }
                            Action { label: @tr("创建完整备份"); enabled: !root.busy && root.maintenance-has-target; clicked => { root.backup-instance(); } }
                        }
                        Action { height: 40px; label: @tr("移除游戏（可恢复）"); enabled: !root.busy && root.maintenance-has-target; clicked => { root.archive-instance(); } }
                        Text { text: @tr("移除只隐藏游戏并保留全部文件。完整备份最多 16 GiB，包含存档、配置和安装资源；请先关闭游戏。"); wrap: word-wrap; color: Theme.secondary; font-size: 13px; }
                    }
                    if root.maintenance-tab == 1: VerticalLayout { spacing: 12px;
                        Text { text: @tr("完整备份"); color: Theme.text; }
                        ComboBox { model: root.client-backups; current-index <=> root.client-backup-index; enabled: !root.busy; }
                        LineEdit { height: 40px; text <=> root.client-restore-parent; placeholder-text: @tr("恢复父目录（已存在的独立目录）"); accessible-label: @tr("游戏恢复父目录"); enabled: !root.busy; }
                        LineEdit { height: 40px; text <=> root.client-restore-name; placeholder-text: @tr("新的文件夹名称"); accessible-label: @tr("游戏恢复文件夹名称"); enabled: !root.busy; }
                        Action { height: 40px; label: @tr("校验并恢复为新游戏"); enabled: !root.busy && root.client-backups.length > 0 && root.client-backup-index >= 0 && root.client-restore-parent != "" && root.client-restore-name != ""; clicked => { root.restore-instance(); } }
                        Text { text: @tr("已移除的游戏"); color: Theme.text; }
                        ComboBox { model: root.archived-games; current-index <=> root.archived-game-index; enabled: !root.busy; }
                        Action { height: 40px; label: @tr("恢复显示"); enabled: !root.busy && root.archived-games.length > 0 && root.archived-game-index >= 0; clicked => { root.unarchive-instance(); } }
                        Text { text: @tr("恢复会创建独立副本，不覆盖原游戏。损坏或同名冲突会停止恢复并保留现场。"); wrap: word-wrap; color: Theme.secondary; font-size: 13px; }
                    }
                }
                if root.panel == 8: VerticalLayout { spacing: 12px; vertical-stretch: 0; alignment: start;
                    Text { vertical-stretch: 0; text: root.content-target; color: Theme.accent; overflow: elide; font-size: 14px; }
                    if !root.content-server: Text {vertical-stretch:0;text:@tr("资源安装位置：") + root.content-destination;color:Theme.secondary;font-size:12px;overflow:elide;}
                    HorizontalLayout { height: 36px; spacing: 12px;
                        Action { label: @tr("查找内容"); selected: root.content-tab == 0; clicked => { root.content-tab=0; } }
                        Action { label: @tr("已安装与恢复"); selected: root.content-tab == 1; clicked => { root.content-tab=1; } }
                    }
                    if root.content-tab == 0 && root.content-step == 0: VerticalLayout { spacing: 10px;
                        HorizontalLayout { height: 40px; spacing: 12px;
                            ComboBox { width: 124px; model: [@tr("模组"), @tr("资源包"), @tr("光影"), @tr("插件")]; current-index <=> root.content-kind-index; enabled: !root.busy; selected(value) => { root.search-content(); } }
                            LineEdit { text <=> root.content-query; accepted => { root.search-content(); } placeholder-text: @tr("搜索 Modrinth"); accessible-label: @tr("搜索内容"); enabled: !root.busy; }
                            Action { width: 80px; label: @tr("搜索"); enabled: !root.busy; clicked => { root.search-content(); } }
                        }
                        HorizontalLayout { height: 28px; spacing: 16px;
                            CheckBox { text: @tr("匹配游戏版本"); checked <=> root.content-match-game; enabled: !root.busy; toggled => { root.search-content(); } }
                            CheckBox { text: @tr("匹配加载器"); checked <=> root.content-match-loader; enabled: !root.busy; toggled => { root.search-content(); } }
                            Text { vertical-stretch: 0; text: @tr("安装前仍会核对兼容性"); color: Theme.secondary; font-size: 13px; vertical-alignment: center; }
                        }
                        HorizontalLayout { height: 36px; spacing: 12px;
                            ComboBox { model: [@tr("相关程度"), @tr("最多下载"), @tr("最近更新"), @tr("最新发布")]; current-index <=> root.content-sort; enabled: !root.busy; selected(value) => { root.search-content(); } }
                            Text { vertical-stretch: 0; text: root.busy ? @tr("正在加载内容…") : root.content-total + @tr(" 个结果"); color: Theme.secondary; vertical-alignment: center; }
                            Action { width: 100px; label: @tr("刷新列表"); enabled: !root.busy; clicked => { root.refresh-content(); } }
                        }
                        if !root.busy && root.content-loaded && root.content-projects.length == 0: Text { vertical-stretch: 0; text: @tr("没有找到内容，请调整关键词或筛选条件。"); color: Theme.secondary; wrap: word-wrap; }
                        ScrollView { height: max(164px,root.height - 560px); content-width: self.width;
                            VerticalLayout { spacing: 8px;
                                for project[index] in root.content-projects: ContentItem { item: project; enabled: !root.busy;
                                    clicked => { root.content-project-index=index; root.content-project-title=project.title; root.content-project-description=project.description; root.content-step=2; root.content-project(); }
                                }
                            }
                        }
                        HorizontalLayout { height: 40px; spacing: 12px;
                            Action { width: 110px; label: @tr("上一页"); enabled: !root.busy && root.content-offset > 0; clicked => { root.content-page(-1); } }
                            Text { vertical-stretch: 0; text: (floor(root.content-offset / 20) + 1) + " / " + max(1,ceil(root.content-total / 20)); color: Theme.secondary; horizontal-alignment: center; vertical-alignment: center; }
                            Action { width: 110px; label: @tr("下一页"); enabled: !root.busy && root.content-offset + 20 < root.content-total && root.content-offset < 100000; clicked => { root.content-page(1); } }
                        }
                    }
                    if root.content-tab == 0 && (root.content-step == 2 || root.content-step == 1): VerticalLayout { spacing: 12px; vertical-stretch: 0; alignment: start;
                        HorizontalLayout { height: 36px; spacing: 12px;
                            Action { width: 150px; height: 36px; label: @tr("返回搜索结果"); enabled: !root.busy; clicked => {root.content-step=0;} }
                            Text { text: root.content-project-title; color: Theme.text; font-size: 20px; font-weight: 600; vertical-alignment: center; }
                            Action { width: 140px; height: 36px; label: @tr("重新加载版本"); enabled: !root.busy; clicked => {root.content-project();} }
                        }
                        Text { text: root.content-project-description; color: Theme.secondary; font-size: 13px; wrap: word-wrap; vertical-stretch: 0; }
                        if root.busy: Text { text: @tr("正在核对版本与依赖…"); color: Theme.accent; vertical-stretch: 0; }
                        if !root.busy && root.content-version-rows.length == 0: Text {text: @tr("没有匹配版本，可以返回调整筛选或重新加载。"); color: Theme.secondary; wrap: word-wrap; vertical-stretch: 0;}
                        ScrollView { height: max(190px,root.height - 400px); content-width: self.width;
                            VerticalLayout { spacing: 8px; alignment: start;
                                for version in root.content-recommendations: ContentVersionItem { item: version; selected: root.content-version-index==version.index; enabled: !root.busy;
                                    clicked => {root.content-version-index=version.index;root.preview-content();}
                                }
                                for group in root.content-version-groups: VerticalLayout { spacing: 6px; vertical-stretch: 0;
                                    Action { height: 40px; leading: true; label: "Minecraft " + group.title; selected: root.content-expanded-group==group.title; clicked => {root.content-expanded-group=root.content-expanded-group==group.title ? "" : group.title;} }
                                    if root.content-expanded-group==group.title: VerticalLayout {spacing:6px;alignment:start;vertical-stretch:0;
                                        for version in group.rows: ContentVersionItem {item:version;selected:root.content-version-index==version.index;enabled:!root.busy;
                                            clicked => {root.content-version-index=version.index;root.preview-content();}
                                        }
                                    }
                                }
                            }
                        }
                    }
                    if root.content-tab == 1: VerticalLayout { spacing: 12px;
                        HorizontalLayout { height: 40px; spacing: 12px;
                            LineEdit { text <=> root.installed-query; placeholder-text: @tr("搜索已安装内容"); edited => { root.installed-page=0; root.filter-installed(); } }
                            ComboBox { width: 160px; model: [@tr("全部状态"), @tr("已安装"), @tr("已移除，可恢复"), @tr("未完成")]; current-index <=> root.installed-filter; selected(value) => { root.installed-page=0; root.filter-installed(); } }
                        }
                        Text { vertical-stretch: 0; text: root.installed-total + @tr(" 个安装组"); color: Theme.secondary; }
                        if root.installed-total == 0: Text { vertical-stretch: 0; text: @tr("还没有匹配的安装组。可以在查找内容中安装，或调整筛选。"); color: Theme.secondary; wrap: word-wrap; }
                        ScrollView { height: max(150px,root.height - 540px); content-width: self.width;
                            VerticalLayout { spacing: 8px;
                                for group in root.content-groups: ContentItem { item: group; selected: root.content-group-index == group.index; enabled: !root.busy; clicked => { root.content-group-index=group.index; root.select-installed(group.index); } }
                            }
                        }
                        HorizontalLayout { height: 36px; spacing: 12px;
                            Action { width: 100px; label: @tr("上一页"); enabled: root.installed-page > 0; clicked => { root.installed-page -= 1; root.filter-installed(); } }
                            Text { vertical-stretch: 0; text: (root.installed-page + 1) + " / " + max(1,ceil(root.installed-total / 20)); color: Theme.secondary; horizontal-alignment: center; vertical-alignment: center; }
                            Action { width: 100px; label: @tr("下一页"); enabled: (root.installed-page + 1)*20 < root.installed-total; clicked => { root.installed-page+=1; root.filter-installed(); } }
                        }
                        if root.content-group-index >= 0: TextEdit { height: 72px; text: root.installed-details; read-only: true; accessible-label: @tr("安装组文件详情"); }
                        HorizontalLayout { height: 40px; spacing: 12px;
                            Action { label: @tr("继续未完成安装"); enabled: !root.busy && root.content-group-index >= 0 && root.content-group-states[root.content-group-index] == "pending"; clicked => { root.change-content("resume"); } }
                            Action { label: @tr("移除（可恢复）"); enabled: !root.busy && root.content-group-index >= 0 && (root.content-group-states[root.content-group-index] == "installed" || root.content-group-states[root.content-group-index] == "pending" || root.content-group-states[root.content-group-index] == "removing"); clicked => { root.change-content("remove"); } }
                            Action { label: @tr("恢复安装组"); enabled: !root.busy && root.content-group-index >= 0 && (root.content-group-states[root.content-group-index] == "removed" || root.content-group-states[root.content-group-index] == "restoring"); clicked => { root.change-content("restore"); } }
                        }
                        Text { vertical-stretch: 0; text: @tr("按安装组管理，共享依赖会保留。修改过的文件会保留并停止操作。"); color: Theme.secondary; wrap: word-wrap; font-size: 12px; }
                    }
                }
                if root.panel == 7: VerticalLayout { spacing: 12px;
                    Text { text: root.update-info; color: Theme.secondary; wrap: word-wrap; }
                    HorizontalLayout { height: 40px; spacing: 12px;
                        Action { label: @tr("检查正式版本"); enabled: !root.busy; clicked => { root.check-update(); } }
                        Action { label: @tr("打开官方下载页"); enabled: root.update-available; clicked => { root.open-release(); } }
                    }
                    Text { vertical-stretch: 0; text: @tr("AmberL · 原生桌面开发预览\nAmbrum Rust 核心 / MPL-2.0\n沿用 AMBER 图形标志，青绿色为 AmberL 识别色。\nSlint 为当前界面实现，最终框架验收尚未完成。"); color: Theme.secondary; wrap: word-wrap; }
                    AboutSlint {}
                }
                if root.panel == 10: VerticalLayout { spacing: 16px; vertical-stretch: 0;
                    HorizontalLayout { height: 40px; spacing: 12px;
                        Action { label: "简体中文"; selected: !Locale.english; clicked => { root.language(false); } }
                        Action { label: "English"; selected: Locale.english; clicked => { root.language(true); } }
                    }
                    Text { text: @tr("外观"); color: Theme.text; }
                    HorizontalLayout { height: 44px; spacing: 12px;
                        Action { label: @tr("深色玻璃"); selected: !Theme.light; clicked => { root.appearance(false); } }
                        Action { label: @tr("浅色玻璃"); selected: Theme.light; clicked => { root.appearance(true); } }
                    }
                    Text { text: @tr("主题色"); color: Theme.text; vertical-stretch: 0; }
                    HorizontalLayout { height: 40px; spacing: 8px;
                        for color in [{value:#62d6b4,hex:"#62d6b4"},{value:#7aa7ff,hex:"#7aa7ff"},{value:#ba8bf0,hex:"#ba8bf0"},{value:#e5aa61,hex:"#e5aa61"},{value:#e97e9a,hex:"#e97e9a"}]: Rectangle { width: 40px; height: 40px; border-radius: Theme.radius; background: color.value; border-width: 1px; border-color: Theme.border;
                            TouchArea { clicked => {root.set-accent(color.hex); } }
                        }
                    }
                    HorizontalLayout { height: 44px; spacing: 12px;
                        LineEdit { text <=> root.accent-input; placeholder-text: "#RRGGBB"; accessible-label: @tr("自定义主题色"); }
                        Action { width: 140px; label: @tr("应用主题色"); clicked => {root.set-accent(root.accent-input);} }
                    }
                    Text { text: @tr("背景图片"); color: Theme.text; vertical-stretch: 0; }
                    Text { text: root.background-name; color: Theme.secondary; overflow: elide; vertical-stretch: 0; }
                    HorizontalLayout { height: 44px; spacing: 12px;
                        Action { label: @tr("选择背景图片"); enabled: !root.appearance-busy; clicked => {root.choose-background();} }
                        Action { label: @tr("恢复默认背景"); enabled: !root.appearance-busy; clicked => {root.reset-background();} }
                    }
                    Text { text: @tr("支持 PNG、JPEG、WebP、GIF。背景和主题色会在下次启动时恢复。"); color: Theme.secondary; wrap: word-wrap; vertical-stretch: 0; }
                    HorizontalLayout { height: 44px; spacing: 12px;
                        Action { label: @tr("当前任务"); clicked => {root.panel=5;} }
                        Action { label: @tr("关于 AmberL"); clicked => {root.panel=7;} }
                    }
                }
                if root.panel != 11 && root.panel != 8: Rectangle { vertical-stretch: 1; }
                if (root.panel == 6 && !root.busy ? root.network-help : root.status-help) != "": Text { text: root.panel == 6 && !root.busy ? root.network-help : root.status-help; color: Theme.accent; wrap: word-wrap; }
                if root.panel != 5: HorizontalLayout { min-height: 44px; spacing: 12px;
                    Text { text: root.panel == 6 && !root.busy ? root.network-status : root.status; color: Theme.secondary; wrap: word-wrap; vertical-alignment: center; }
                    if root.busy: Action { width: Locale.english ? 220px : 176px; height: 44px; label: root.running ? @tr("请求游戏正常退出") : @tr("取消当前操作"); clicked => { root.cancel(); } }
                }
            }
            }
        }
    }
    if root.panel == 8 && root.content-step == 1: Rectangle { x: 0px; y: 92px; width: root.width; height: root.height - 92px; background: #00000070;
        TouchArea { }
        Glass { x: (parent.width - self.width)/2; y: 16px; width: min(760px,parent.width - 64px); height: parent.height - 36px;
            viewport-width: root.width; viewport-height: root.height; scene-x: self.x; scene-y: self.y + 92px; tint: Theme.light ? #f4faf5f5 : #14262ff5;
            VerticalLayout { padding: root.height < 640px ? 16px : 24px; spacing: root.height < 640px ? 8px : 12px; alignment: start;
                Text { text: @tr("模组下载") + " · " + root.content-project-title; color: Theme.text; font-size: 22px; font-weight: 600; vertical-stretch: 0; overflow: elide; }
                Text { text: @tr("下载到当前实例") + " · " + root.content-target; color: Theme.accent; font-size: 13px; vertical-stretch: 0; }
                if !root.content-server: Text {text:root.content-destination;color:Theme.secondary;font-size:12px;vertical-stretch:0;overflow:elide;}
                ScrollView { min-height: 48px; vertical-stretch: 1; content-width: self.width;
                    VerticalLayout { spacing: 10px; alignment: start;
                        Text { text: root.content-plan-summary; color: Theme.text; font-weight: 600; vertical-stretch: 0; }
                        for file in root.content-plan-files: Rectangle { height: 58px; background: Theme.control; border-radius: Theme.radius;
                            Text {x:12px;y:8px; height:22px; width: parent.width - 120px;text:file.title;color:Theme.text;overflow:elide;}
                            Text {x:12px;y:32px; height:18px; width:parent.width - 24px;text:file.path;color:Theme.secondary;font-size:12px;overflow:elide;}
                            if file.downloaded: Text {x:parent.width - 90px;y:10px;width:76px;height:20px;text:@tr("已下载");color:Theme.accent;font-size:12px;horizontal-alignment:right;}
                        }
                        Text {text:@tr("必要依赖");color:Theme.text;font-weight:600;vertical-stretch:0;}
                        for dependency[index] in root.content-required: Rectangle {height:58px;background:Theme.control;border-radius:Theme.radius;
                            Rectangle {x:10px;y:9px;width:40px;height:40px;border-radius:Theme.radius;background:Theme.selection;
                                if dependency.has-icon: Image {x:4px;y:4px;width:32px;height:32px;source:dependency.icon;image-fit:contain;}
                            }
                            CheckBox {x:62px;y:11px;width:parent.width - 74px;height:36px;text:dependency.title + (dependency.downloaded ? " · " + @tr("已下载") : "");checked:dependency.selected;enabled:!root.busy;toggled => {root.select-required(index,self.checked);} }
                        }
                        if root.content-required.length == 0: Text {text:@tr("无必要依赖");color:Theme.secondary;vertical-stretch:0;}
                        Text {text:@tr("可选依赖");color:Theme.text;font-weight:600;vertical-stretch:0;}
                        for dependency[index] in root.content-optional: Rectangle {height:58px;background:Theme.control;border-radius:Theme.radius;
                            Rectangle {x:10px;y:9px;width:40px;height:40px;border-radius:Theme.radius;background:Theme.selection;
                                if dependency.has-icon: Image {x:4px;y:4px;width:32px;height:32px;source:dependency.icon;image-fit:contain;}
                            }
                            CheckBox {x:62px;y:11px;width:parent.width - 74px;height:36px;text:dependency.title + (dependency.downloaded ? " · " + @tr("已下载") : "");checked:dependency.selected;enabled:!root.busy;toggled => {root.select-optional(index,self.checked);} }
                        }
                        if root.content-optional.length == 0: Text {text:@tr("无可选依赖");color:Theme.secondary;vertical-stretch:0;}
                    }
                }
                Text { text: root.content-skipped-required > 0 ? @tr("已取消必要依赖，游戏或模组可能无法启动。") : @tr("已下载且校验通过的依赖不会重复下载。"); color: root.content-skipped-required > 0 ? #e5aa61 : Theme.secondary;wrap:word-wrap;font-size:12px;vertical-stretch:0; }
                HorizontalLayout {height:44px;spacing:12px;
                    Action {label:@tr("返回选择");enabled:!root.busy;clicked => {root.content-step=2;} }
                    Action {label:root.busy ? @tr("正在核对…") : @tr("安装到当前实例");primary:true;enabled:!root.busy && root.content-has-plan;clicked => {root.install-content();} }
                }
            }
        }
    }
    Rectangle { x: 0px; y: 0px; width: root.width; height: 90px;
        Glass {
            x: 24px; y: 20px; width: parent.width - 48px; height: 64px;
            viewport-width: root.width; viewport-height: root.height; scene-x: self.x; scene-y: self.y;
            TouchArea { pointer-event(event) => { if event.kind == down && event.button == left { root.move-window(); } } x: 0px; y: 0px; width: parent.width; height: parent.height; }
            Rectangle { x: 12px; y: 8px; width: 166px; height: 48px; background: Theme.light ? #173e35 : transparent; border-radius: Theme.radius;
                Image { x: 6px; y: 2px; width: 154px; height: 44px; source: @image-url("../../../assets/launcher/amberl-lockup.svg"); image-fit: contain; accessible-label: "AmberL"; }
            }
            Action { x: 190px; y: 12px; width: 58px; height: 40px; label: @tr("游戏"); selected: root.panel == 0; clicked => { root.panel=0; } }
            Action { x: 254px; y: 12px; width: Locale.english ? 88px : 64px; height: 40px; label: @tr("资源"); selected: root.panel == 8; enabled: !root.busy; clicked => { root.open-content(false); } }
            Action { x: Locale.english ? 348px : 324px; y: 12px; width: Locale.english ? 104px : 64px; height: 40px; label: @tr("联机"); selected: root.panel == 6; flat: root.panel != 6; clicked => { root.panel=6; } }
            if root.width >= 1000px: Action { x: parent.width - 340px; y: 12px; width: 72px; height: 40px; label: @tr("任务"); flat: true; clicked => { root.panel=5; } }
            Action { x: parent.width - 264px; y: 12px; width: 72px; height: 40px; label: @tr("设置"); flat: true; clicked => { root.panel=10; } }
            if root.width >= 1000px: Action { x: parent.width - 188px; y: 12px; width: 72px; height: 40px; label: @tr("关于"); flat: true; clicked => { root.panel=7; } }
        }
    }
    TouchArea { pointer-event(event) => { if event.kind == down && event.button == left { root.move-window(); } } x: 12px; y: 4px; width: root.width - 24px; height: 16px; }
    TouchArea { pointer-event(event) => { if event.kind == down && event.button == left { root.move-window(); } } x: 24px; y: 24px; width: 176px; height: 56px; }
    TouchArea { pointer-event(event) => { if event.kind == down && event.button == left { root.move-window(); } } x: Locale.english ? 490px : 420px; y: 24px; width: max(0px, root.width - self.x - 410px); height: 56px; }
    Text { x: root.width - 22px; y: root.height - 24px; text: "◢"; color: #a7c0bd80; font-size: 15px; }
    TouchArea { x: root.width - 26px; y: root.height - 26px; width: 26px; height: 26px; mouse-cursor: se-resize; pointer-event(event) => { if event.kind == down { root.resize-window(); } } }
    HorizontalLayout { x: root.width - 148px; y: 34px; width: 112px; height: 36px; spacing: 2px;
        WindowControl { kind: "minimize"; label: @tr("最小化"); clicked => {root.minimize();} }
        WindowControl { kind: root.window-maximized ? "restore" : "maximize"; label: @tr("最大化或还原"); clicked => {root.maximize();} }
        WindowControl { kind: "close"; label: @tr("关闭窗口"); clicked => {root.close();} }
    }
}
